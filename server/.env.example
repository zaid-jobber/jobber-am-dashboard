# Copy to .env. All self-serve (no IT/admin).

# Free key from https://openweathermap.org/api
OPENWEATHER_KEY=

# ---- Gmail + Calendar: pick ONE bridge ----

# Option A (preferred): Zapier MCP. Create a server at https://mcp.zapier.com,
# add Gmail + Google Calendar "find" actions, copy the server URL (it embeds your key).
ZAPIER_MCP_URL=
# After connecting, hit http://localhost:3001/api/mcp/tools to see exact action
# names, then set them here:
ZAPIER_MCP_GMAIL_TOOL=
ZAPIER_MCP_CALENDAR_TOOL=

# Option B (fallback): Storage by Zapier. Secret from a Storage by Zapier step;
# Zaps push to lists `gmail` / `calendar` (see README).
ZAPIER_SECRET=

# ---- Salesforce sync (BUILD-AHEAD: leave blank until you get a Connected App) ----
# Once RevOps grants a Connected App, fill these and the app auto-syncs your book.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
SF_LOGIN_URL=https://login.salesforce.com
SF_API_VERSION=v60.0
# Optional SOQL to scope to your accounts, e.g. OwnerId = '005XXXXXXXXXXXX'
SF_OWNER_FILTER=

# ---- AI (OpenAI / ChatGPT Enterprise) — generates call scripts, emails, texts ----
# BUILD-AHEAD: leave blank to use offline templates. Add your key to go live.
OPENAI_API_KEY=
# Optional: point at an Azure/enterprise gateway and pick the model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

PORT=3001

# --- Slack tile (announcement channels) ---
# Reads recent messages from these channels (any sender, main posts only).
SLACK_TILE_CHANNELS=GL55WD2N4,C0314D9QFAM
SLACK_TILE_CHANNEL_NAMES=announce-expansion,announce-product_updates
# Optional bot token for the most reliable channel-history read + live promos canvas.
# Scopes: channels:history, groups:history, channels:read, groups:read, users:read
# SLACK_BOT_TOKEN=xoxb-...
# PROMO_CANVAS_ID=F08QJTU0F4Z
